# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=foodstore_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seguridad JWT
SECRET_KEY=your-super-secret-key-min-32-chars-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (admin suele ir en 5175 en dev)
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

# Redis (opcional en dev con un solo worker; obligatorio con --workers > 1)
# Local con Docker: redis://localhost:6379/0
REDIS_URL=
REDIS_WS_CHANNEL=foodstore:ws

# Multi-tenant (default legacy = una sola DB como hoy)
TENANT_MODE=legacy
CONTROL_POSTGRES_DB=foodstore_control
DEFAULT_TENANT_SLUG=
TENANT_BASE_DOMAIN=

# API pública (landings)
PUBLIC_TIENDA_ABIERTA=true

# Facturación ARCA (WSFE; mock en dev)
ARCA_AMBIENTE=homologacion
ARCA_CERT_PATH=
ARCA_KEY_PATH=

# MercadoPago (credenciales de prueba)
# Obtenelas en: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=   # secreto para validar firma del webhook (usa ACCESS_TOKEN si se deja vacío)
MP_NOTIFICATION_URL=
# Base pública de la API (prod). Webhook por local: {API_PUBLIC_BASE_URL}/webhooks/mp/{slug}
API_PUBLIC_BASE_URL=

# OAuth MP por local (panel developers → credenciales de producción / prueba)
MP_APP_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/mp/callback
MP_OAUTH_ADMIN_RETURN_URL=http://localhost:5175
# Opcional: Fernet key; si vacío se deriva de SECRET_KEY
MP_TOKEN_ENCRYPTION_KEY=

# Cloudinary (credenciales de cuenta)
# Obtenelas en: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
